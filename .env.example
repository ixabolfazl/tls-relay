# Admin panel credentials
# Copy this file to .env and fill in real values before running the service.
# The .env file is gitignored and must never be committed.

PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=change_me_before_deploying
# Optional custom path prefix for admin panel (default: "/admin")
# The landing page (DNS info, domain lookup, IP registration) is served at /
# The admin panel is served at PANEL_PATH (e.g. /admin)
PANEL_PATH=/admin

# Relay server public IP for authoritative DNS A-record responses
RELAY_IP=server-ip

# Access mode: "user" (default, secure) or "public" (open to everyone).
# In "user" mode only IPs registered via the magic link are permitted.
# Switching to "public" re-enables open access WITHOUT restarting or rebuilding.
ACCESS_MODE=user

# Outbound SOCKS5 egress
EGRESS_PROXY_ENABLED=false
EGRESS_PROXY_ADDR=127.0.0.1:1080
EGRESS_PROXY_USER=
EGRESS_PROXY_PASSWORD=
